#version 450

struct SphereNode {
    vec4 pos;
    vec4 color;
    vec4 vel;
    vec4 originPos;
    vec4 prevPos;
    vec4 normal;
    float isFixed;
    float isSurface;
    float padding[2];
};

// C++에서 설정한 Descriptor Sets와 매칭
layout(std430, binding = 0) readonly buffer InputNodes {
    SphereNode nodesIn[];
};

layout(std430, binding = 1) writeonly buffer OutputNodes {
    SphereNode nodesOut[];
};

layout(std430, binding = 2) buffer Multipliers {
    float lambdas[];
};

// Push Constant
layout(push_constant) uniform PushConstants {
    float dt;
    float u_Time;
    int subStepCnt;
    float padding;
};

// 워크그룹 크기 설정
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// 시뮬레이션 상수
const float stiffness = 1048576.0 / 8.0;
//const float stiffness = 16384.0;
const float compliance = 1.0 / stiffness; // XPBD의 alpha값 (역강성)
const int WIDTH = 16;
const int HEIGHT = 16;
const int DEPTH = 16;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    uint index = x + y * WIDTH + z * WIDTH * HEIGHT;
    if(index >= nodesIn.length()) return;

    SphereNode current = nodesIn[index];
    float w1 = (current.isFixed > 0.5) ? 0.0 : 1.0;

    if (w1 == 0.0) {
        nodesOut[index] = current;
        return;
    }

    vec3 p1 = current.pos.xyz;
    vec3 p1_orig = current.originPos.xyz;
    vec3 total_dx = vec3(0.0);
    int constraint_count = 0;

    // Substep에 따른 시간 간격(sdt) 계산
    float sdt = dt / float(subStepCnt);
    // XPBD 시간 스케일 적용된 compliance (alpha_tilde = alpha / dt^2)
    float alpha_tilde = compliance / (sdt * sdt);

    // 26개의 이웃 노드 (Moore neighborhood)에 대해 거리 제약조건(Distance Constraint) 평가
    for (int dz = -1; dz <= 1; dz++) {
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0 && dz == 0) continue;

                int nx = int(x) + dx;
                int ny = int(y) + dy;
                int nz = int(z) + dz;

                // 3D 그리드 경계 체크
                if (nx < 0 || nx >= WIDTH || ny < 0 || ny >= HEIGHT || nz < 0 || nz >= DEPTH) continue;

                uint neighbor_index = nx + ny * WIDTH + nz * WIDTH * HEIGHT;
                SphereNode neighbor = nodesIn[neighbor_index];
                float w2 = (neighbor.isFixed > 0.5) ? 0.0 : 1.0;
                float w_sum = w1 + w2;

                if (w_sum == 0.0) continue;

                vec3 p2 = neighbor.pos.xyz;
                vec3 p2_orig = neighbor.originPos.xyz;

                vec3 dir = p1 - p2;
                float len = length(dir);
                if (len < 0.0001) continue; // 0으로 나누기 방지
                vec3 n = dir / len;

                float rest_len = length(p1_orig - p2_orig);
                float C = len - rest_len;

                // [추가됨] 고유 람다 인덱스 계산 (0 ~ 26)
                // dx, dy, dz는 -1 ~ 1 이므로 1을 더해 0 ~ 2로 만듦
                int local_dir_idx = (dz + 1) * 9 + (dy + 1) * 3 + (dx + 1);
                uint lambda_index = index * 27 + local_dir_idx;

                // 기존 누적된 람다 읽기
                float current_lambda = lambdas[lambda_index];
                
                // XPBD 보정량 계산
                float delta_lambda = (-C - alpha_tilde * current_lambda) / (w_sum + alpha_tilde);

                // [추가됨] 람다 버퍼 업데이트
                lambdas[lambda_index] += delta_lambda;

                // 위치 보정량 누적
                vec3 dx_update = w1 * delta_lambda * n;
                total_dx += dx_update;
                constraint_count++;
            }
        }
    }

    // --- STEP 1: Jacobi 방식으로 제약 조건 평균 적용 ---
    if (constraint_count > 0) {
        p1 += total_dx / float(constraint_count);
    }

    current.pos = vec4(p1, 1.0);
    nodesOut[index] = current;
}